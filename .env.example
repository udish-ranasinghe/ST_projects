# Copy this file to .env and fill in the values
# cp .env.example .env

# ---------------------------------------------------------------------------
# Model configuration
# ---------------------------------------------------------------------------
# Hugging Face model ID (leave blank to use mock/demo mode)
MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# Force mock/demo mode even if the model is available (set to "true" for CI/tests)
# MOCK_MODE=false

# ---------------------------------------------------------------------------
# Agent settings
# ---------------------------------------------------------------------------
# Maximum number of plan→act→observe steps per turn
AGENT_MAX_STEPS=3

# Maximum message length (characters)
MAX_MSG_CHARS=1000

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=20

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_FILE=logs/agent_turns.jsonl

# ---------------------------------------------------------------------------
# UI settings
# ---------------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
UI_HOST=0.0.0.0
UI_PORT=7860
# Set to "true" to show plan/observation debug panels in the UI
SHOW_DEBUG=false
# Set to "true" to create a public Gradio share link
GRADIO_SHARE=false
